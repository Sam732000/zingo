function decItem(id){
  if(!cart[id]) return;
  cart[id] -= 1;
  if(cart[id] <= 0) delete cart[id];
  const ctrl = document.getElementById('ctrl-'+id);
  if(ctrl) ctrl.innerHTML = controlHtml(id);
  updateCartbar();
