  const err = document.getElementById('cf-err');

  const phoneOk = /^\d{10}$/.test(phone);
  const pinOk = /^\d{6}$/.test(pin);

  if(!name || !phoneOk || !address || !area || !pinOk){
    err.style.display = 'block';
    return;
  }
  err.style.display = 'none';
  customer = { name, phone, address, area, pin };
  document.getElementById('pay-amount').textContent = '₹' + (cartSubtotal()+DELIVERY_FEE+PACKAGING_FEE);
  goTo('payment');
}

/* ---------------- payment ---------------- */
function selectPay(method){
  chosenMethod = method;
  document.querySelectorAll('.pay-opt').forEach(el=>{
    el.classList.toggle('selected', el.dataset.method === method);
  });
  const btn = document.getElementById('pay-btn');
  btn.textContent = method === 'whatsapp' ? 'Send order on WhatsApp' : 'Pay now';
}

function buildWaMessage(order){
  const lines = order.items.map(({item,qty}) => `• ${item.nm} x${qty} — ₹${item.pr*qty}`).join('\n');
  const c = order.customer;
  return `Hi Zingo! I'd like to order (${order.id}):\n\n${lines}\n\nDelivery: ₹${DELIVERY_FEE}  Packaging: ₹${PACKAGING_FEE}\nTotal: ₹${order.total}\n\nName: ${c.name || ''}\nPhone: ${c.phone || ''}\nAddress: ${c.address || ''}, ${c.area || ''} - ${c.pin || ''}`;
}

function startPayment(){
  if(chosenMethod === 'whatsapp'){
    pendingOrder = buildOrderObject('whatsapp');
    const msg = encodeURIComponent(buildWaMessage(pendingOrder));
    window.open(`https://wa.me/${WA_NUMBER}?text=${msg}`, '_blank');
    logOrder(pendingOrder, 'placed');
    document.getElementById('payment-select').style.display = 'none';
    document.getElementById('wa-wait').classList.add('show');
    return;
  }

  document.getElementById('payment-select').style.display = 'none';
  const loadingWrap = document.getElementById('payment-loading');
  loadingWrap.classList.add('show');
  document.getElementById('pl-title').textContent =
    chosenMethod === 'phonepe' ? 'Redirecting to PhonePe…' : 'Redirecting to Razorpay…';

  /* ============================================================
     PAYMENT INTEGRATION — READ THIS BEFORE GOING LIVE
     ------------------------------------------------------------
     This is a DEMO. It only simulates success after a delay.
     A real flow needs a backend server (Node/PHP/Python etc.)
     because gateway secret keys can never live in this HTML file.

     Real flow looks like:
     1. Browser calls YOUR server:  POST /api/create-order
        body: { cart, customer, amount }
     2. Your server calls PhonePe or Razorpay's API using your
        MERCHANT ID + SECRET KEY (kept only on the server) to
        create a payment session, and gets back a redirect URL
        (PhonePe "Standard Checkout") or an order_id (Razorpay).
     3. Browser redirects the user to that URL (PhonePe) or opens
        the gateway's checkout widget (Razorpay Checkout.js).
     4. User pays on the gateway's own page — you never see card
        or UPI details.
     5. Gateway redirects back to a page on your site AND sends a
        server-to-server webhook to your backend.
     6. Your server VERIFIES the payment signature/status with
        the gateway's API (never trust the redirect alone — a
        redirect can be faked) and only THEN marks the order paid.
     7. Browser polls YOUR server (GET /api/order-status/:id) and
        shows the confirmation once your server says it's paid.

     Swap the setTimeout() below for that real request/response
     cycle once your backend endpoints exist.
     ============================================================ */
  setTimeout(()=>{
    document.getElementById('pl-title').textContent = 'Payment successful';
    document.getElementById('pl-sub').textContent = 'Confirming your order…';
    setTimeout(()=>{
      completeOrder();
    }, 900);
  }, 1800);
}

function completeOrder(){
  lastOrder = pendingOrder || buildOrderObject(chosenMethod);
  renderConfirmation();
  goTo('confirm');
  startOrderTracking();
  logOrder(lastOrder, 'confirmed');
  // reset payment view state for next time
  document.getElementById('payment-select').style.display = 'block';
  document.getElementById('payment-loading').classList.remove('show');
  document.getElementById('wa-wait').classList.remove('show');
  pendingOrder = null;
}

function cancelWaWait(){
  document.getElementById('wa-wait').classList.remove('show');
  document.getElementById('payment-select').style.display = 'block';
}

const TRACK_STAGES = ['placed','preparing','out','delivered'];
let trackTimers = [];

function fmtTime(d){
  return d.toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' });
}

function setStage(stage){
  const idx = TRACK_STAGES.indexOf(stage);
  document.querySelectorAll('.ot-step').forEach(el=>{
    const sIdx = TRACK_STAGES.indexOf(el.dataset.stage);
    el.classList.toggle('done', sIdx < idx);
    el.classList.toggle('active', sIdx === idx);
    if(sIdx <= idx){
      const timeEl = document.getElementById('ot-time-'+el.dataset.stage);
      if(timeEl.textContent === '—') timeEl.textContent = fmtTime(new Date());
    }
  });
  const etaTitle = document.getElementById('eta-title');
  if(etaTitle){
    if(stage==='placed') etaTitle.textContent = 'Order received — arriving in ~35–40 mins';
    if(stage==='preparing') etaTitle.textContent = 'Being prepared — arriving in ~25–30 mins';
    if(stage==='out') etaTitle.textContent = 'Out for delivery — arriving in ~10–12 mins';
    if(stage==='delivered') etaTitle.textContent = 'Delivered — enjoy your meal!';
  }
}

function startOrderTracking(){
  /* ============================================================
     ORDER TRACKING — READ THIS BEFORE GOING LIVE
     ------------------------------------------------------------
     This demo auto-advances the stages on a timer so you can see
     how it looks. For real tracking you need your backend to be
     the source of truth for order status, updated by:
       - your kitchen staff tapping "Start preparing" / "Out for
         delivery" / "Delivered" on a simple order-management
         screen, OR
       - a delivery partner's API/webhook (if you use one).
     This page should then either:
       a) poll   GET /api/order-status/:orderId   every ~10s, or
       b) open a WebSocket / Server-Sent Events connection
     and call setStage(status) with whatever the backend returns,
     instead of the setTimeout() calls below.
     ============================================================ */
  trackTimers.forEach(t=>clearTimeout(t));
  document.querySelectorAll('.ot-time').forEach(el=>el.textContent='—');
  setStage('placed');
  trackTimers = [
    setTimeout(()=>setStage('preparing'), 4000),
    setTimeout(()=>setStage('out'), 12000),
    setTimeout(()=>setStage('delivered'), 20000),
  ];
}

function renderConfirmation(){
  document.getElementById('tk-id').textContent = '#' + lastOrder.id;
  document.getElementById('tk-name').textContent = lastOrder.customer.name;
  document.getElementById('tk-addr').textContent = `${lastOrder.customer.area}, ${lastOrder.customer.pin}`;
  const methodLabels = { phonepe:'PhonePe', razorpay:'Razorpay', whatsapp:'WhatsApp (Pay on delivery)' };
  document.getElementById('tk-method').textContent = methodLabels[lastOrder.method] || lastOrder.method;
  document.getElementById('tk-total').textContent = '₹' + lastOrder.total;
  document.getElementById('tk-items').innerHTML = lastOrder.items.map(({item,qty})=>
    `<div class="row"><span>${item.nm} × ${qty}</span><span>₹${item.pr*qty}</span></div>`
  ).join('');
}

function newOrder(){
  trackTimers.forEach(t=>clearTimeout(t));
  cart = {};
  document.getElementById('cf-name').value='';
  document.getElementById('cf-phone').value='';
  document.getElementById('cf-address').value='';
  document.getElementById('cf-area').value='';
  document.getElementById('cf-pin').value='';
  selectPay('whatsapp');
  renderMenu();
  updateCartbar();
  goTo('menu');
}

function updateWaFloat(){
  const el = document.getElementById('wa-float');
  let msg = "Hi Zingo! I'd like to know more about your menu.";
  if(cartCount() > 0){
    const lines = Object.entries(cart).map(([id,qty])=>{
      const item = MENU.find(m=>m.id===id);
      return `• ${item.nm} x${qty} — ₹${item.pr*qty}`;
    }).join('\n');
    msg = `Hi Zingo! I'd like to order:\n\n${lines}\n\nTotal (before delivery): ₹${cartSubtotal()}`;
  }
  el.href = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msg)}`;
}

/* ---------------- navigation ---------------- */
const STEP_ORDER = ['menu','cart','checkout','payment','confirm'];
function goTo(view){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+view).classList.add('active');

  const idx = STEP_ORDER.indexOf(view);
  document.querySelectorAll('.tracker .step').forEach(step=>{
    const sIdx = STEP_ORDER.indexOf(step.dataset.step);
    step.classList.toggle('active', sIdx===idx);
    step.classList.toggle('done', sIdx<idx);
  });

  if(view==='cart') renderCart();
  updateWaFloat();
  window.scrollTo({top:0, behavior:'smooth'});
}

/* ---------------- init ---------------- */
renderMenu();
goTo('menu');
</script>
