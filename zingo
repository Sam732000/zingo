<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zingo — Order Online</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1b1b18;
    --steel:#26251f;
    --steel-2:#312f27;
    --turmeric:#f0a532;
    --turmeric-dim:#a8762b;
    --chili:#b23a2e;
    --zred:#ea1d25;
    --zyellow:#ffc72c;
    --paper:#ede6d6;
    --paper-dim:#d9d0ba;
    --off:#f3efe4;
    --off-dim:#c9c4b6;
    --radius:14px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background:var(--ink);
    color:var(--off);
    font-family:'Space Grotesk', sans-serif;
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  .display{font-family:'Archivo Black', sans-serif; letter-spacing:-0.01em;}
  .mono{font-family:'Space Mono', monospace;}

  a, button{font-family:inherit;}

  /* ---------- App shell ---------- */
  #app{max-width:480px; margin:0 auto; min-height:100vh; background:var(--ink); position:relative; padding-bottom:32px;}

  header.top{
    padding:20px 20px 14px;
    display:flex; align-items:center; gap:12px;
    border-bottom:1px solid #38362c;
    position:sticky; top:0; background:var(--ink); z-index:20;
  }
  .tin-mark{width:34px; height:34px; flex-shrink:0;}
  .brand{display:flex; flex-direction:column; line-height:1;}
  .brand .name{font-size:19px; letter-spacing:0.02em;}
  .brand .tag{font-size:10px; color:var(--off-dim); text-transform:uppercase; letter-spacing:0.14em; margin-top:4px; font-family:'Space Mono',monospace;}

  /* ---------- Step tracker ---------- */
  .tracker{
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 20px 4px; gap:4px;
  }
  .tracker .step{display:flex; flex-direction:column; align-items:center; gap:6px; flex:1; position:relative;}
  .tracker .step .tin{
    width:22px; height:22px; border-radius:50%;
    border:2px solid var(--off-dim); background:transparent;
    display:flex; align-items:center; justify-content:center;
    transition:all .25s ease;
  }
  .tracker .step.active .tin{border-color:var(--turmeric); background:var(--turmeric); box-shadow:0 0 0 4px rgba(232,163,61,0.18);}
  .tracker .step.done .tin{border-color:var(--turmeric); background:var(--ink);}
  .tracker .step.done .tin::after{content:'✓'; color:var(--turmeric); font-size:12px; font-weight:700;}
  .tracker .step .lbl{font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--off-dim); font-family:'Space Mono',monospace; text-align:center;}
  .tracker .step.active .lbl{color:var(--turmeric);}
  .tracker .line{position:absolute; top:11px; left:50%; width:100%; height:2px; background:#38362c; z-index:-1;}
  .tracker .step:last-child .line{display:none;}
  .tracker .step.done .line, .tracker .step.active .line{background:var(--turmeric-dim);}

  main{padding:18px 20px 8px;}
  .view{display:none; animation:fade .28s ease;}
  .view.active{display:block;}
  @keyframes fade{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;}}

  /* ---------- Menu view ---------- */
  .hero{
    background:linear-gradient(160deg, var(--steel-2), var(--steel));
    border-radius:var(--radius);
    padding:22px 20px;
    margin-bottom:22px;
    position:relative;
    overflow:hidden;
    border:1px solid #3a382d;
  }
  .hero .eyebrow{font-family:'Space Mono',monospace; font-size:11px; color:var(--turmeric); text-transform:uppercase; letter-spacing:0.14em; margin-bottom:10px;}
  .hero h1{font-size:26px; line-height:1.15; margin-bottom:10px;}
  .hero p{color:var(--off-dim); font-size:13.5px; line-height:1.5; max-width:34ch;}
  .hero .tins-deco{position:absolute; right:-10px; bottom:-14px; opacity:0.15; width:110px;}

  .best-label{
    display:inline-flex; align-items:center; gap:6px;
    background:linear-gradient(90deg, var(--zyellow), #d99a1a);
    color:#1b1b18; font-family:'Space Mono',monospace; font-size:11px; font-weight:700;
    text-transform:uppercase; letter-spacing:0.1em; padding:6px 12px; border-radius:20px;
    margin-bottom:12px;
  }
  .best-strip{display:flex; gap:10px; overflow-x:auto; padding-bottom:6px; margin-bottom:6px; -ms-overflow-style:none; scrollbar-width:none;}
  .best-strip::-webkit-scrollbar{display:none;}
  .best-card{
    flex:0 0 auto; width:150px; background:var(--steel); border:1.5px solid var(--zyellow);
    border-radius:12px; padding:12px; cursor:pointer; transition:transform .12s ease;
  }
  .best-card:active{transform:scale(0.96);}
  .best-card .nm{font-size:12.5px; font-weight:700; line-height:1.3; margin-bottom:8px; min-height:32px;}
  .best-card .pr{font-family:'Space Mono',monospace; font-size:13px; color:var(--zyellow);}
  .badge-best{
    display:inline-block; font-family:'Space Mono',monospace; font-size:9px; font-weight:700;
    color:#1b1b18; background:var(--zyellow); padding:2px 6px; border-radius:8px; letter-spacing:0.06em;
    margin-left:7px; vertical-align:middle; text-transform:uppercase;
  }
  .item.highlight{background:rgba(255,199,44,0.08); border-radius:10px; transition:background 1.4s ease;}

  .cat-title{
    font-size:12px; text-transform:uppercase; letter-spacing:0.14em; color:var(--turmeric);
    font-family:'Space Mono',monospace; margin:26px 0 12px;
    display:flex; align-items:center; gap:8px;
  }
  .cat-title::after{content:''; flex:1; height:1px; background:#38362c;}

  .item{
    display:flex; gap:12px; padding:14px 0; border-bottom:1px solid #302f27;
  }
  .item .veg{width:15px; height:15px; border:1.5px solid #4c9a4c; border-radius:3px; flex-shrink:0; margin-top:3px; display:flex; align-items:center; justify-content:center;}
  .item .veg::after{content:''; width:7px; height:7px; border-radius:50%; background:#4c9a4c;}
  .item .veg.non::after{background:var(--chili);}
  .item .veg.non{border-color:var(--chili);}
  .item .info{flex:1; min-width:0;}
  .item .info .nm{font-size:15px; font-weight:600; margin-bottom:3px;}
  .item .info .ds{font-size:12.5px; color:var(--off-dim); line-height:1.4; margin-bottom:8px;}
  .item .info .pr{font-family:'Space Mono',monospace; font-size:14px; color:var(--turmeric);}
  .item .addbtn{
    align-self:flex-start; margin-top:2px;
    background:transparent; border:1.5px solid var(--turmeric); color:var(--turmeric);
    padding:6px 14px; border-radius:20px; font-size:12px; font-weight:700;
    cursor:pointer; white-space:nowrap; transition:all .15s ease;
    font-family:'Space Mono',monospace;
  }
  .item .addbtn:active{transform:scale(0.95);}
  .item .qty-ctrl{display:flex; align-items:center; gap:10px; background:var(--turmeric); border-radius:20px; padding:5px 6px;}
  .item .qty-ctrl button{background:var(--ink); color:var(--turmeric); border:none; width:22px; height:22px; border-radius:50%; font-size:14px; font-weight:700; cursor:pointer;}
  .item .qty-ctrl span{color:var(--ink); font-weight:700; font-size:13px; min-width:14px; text-align:center;}

  /* ---------- Cart bar ---------- */
  .cartbar{
    position:sticky; bottom:0; left:0; right:0;
    background:var(--turmeric); color:var(--ink);
    padding:14px 18px; margin:20px -20px -8px;
    border-radius:16px 16px 0 0;
    display:none; align-items:center; justify-content:space-between;
    box-shadow:0 -6px 20px rgba(0,0,0,0.35);
    cursor:pointer; border:none; width:calc(100% + 40px);
    font-family:inherit;
  }
  .cartbar.show{display:flex;}

  .wa-float{
    position:fixed; bottom:22px; right:calc(50% - 240px + 18px);
    width:54px; height:54px; border-radius:50%; background:#25D366;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 6px 18px rgba(0,0,0,0.4); z-index:50; text-decoration:none;
    transition:transform .15s ease;
  }
  .wa-float:active{transform:scale(0.92);}
  @media (max-width:520px){
    .wa-float{right:18px;}
  }
  .cartbar .l{font-size:13px; font-weight:700;}
  .cartbar .l small{display:block; font-size:11px; font-weight:500; opacity:0.75; font-family:'Space Mono',monospace;}
  .cartbar .r{display:flex; align-items:center; gap:6px; font-weight:700; font-size:14px;}

  /* ---------- Buttons ---------- */
  .btn-primary{
    width:100%; background:var(--turmeric); color:var(--ink); border:none;
    padding:15px; border-radius:12px; font-size:15px; font-weight:700;
    cursor:pointer; font-family:inherit; transition:transform .12s ease;
  }
  .btn-primary:active{transform:scale(0.98);}
  .btn-primary:disabled{background:#5c5646; color:#8a8474; cursor:not-allowed;}
  .btn-ghost{
    width:100%; background:transparent; color:var(--off-dim); border:1.5px solid #3a382d;
    padding:13px; border-radius:12px; font-size:13.5px; font-weight:600; cursor:pointer; font-family:inherit; margin-top:10px;
  }

  /* ---------- Cart view ---------- */
  .cart-row{display:flex; align-items:center; gap:12px; padding:14px 0; border-bottom:1px solid #302f27;}
  .cart-row .nm{flex:1; font-size:14.5px; font-weight:600;}
  .cart-row .nm small{display:block; font-family:'Space Mono',monospace; font-size:12px; color:var(--off-dim); font-weight:400; margin-top:2px;}
  .cart-row .qty-ctrl{display:flex; align-items:center; gap:10px; background:var(--steel); border:1px solid #3a382d; border-radius:20px; padding:5px 8px;}
  .cart-row .qty-ctrl button{background:none; border:none; color:var(--turmeric); font-size:15px; font-weight:700; cursor:pointer; width:16px;}
  .cart-row .qty-ctrl span{font-size:13px; min-width:14px; text-align:center;}
  .cart-row .line-pr{font-family:'Space Mono',monospace; font-size:13.5px; min-width:58px; text-align:right;}

  .empty-cart{text-align:center; padding:60px 20px; color:var(--off-dim);}
  .empty-cart .tin-mark{width:56px; height:56px; margin:0 auto 18px; opacity:0.4;}
  .empty-cart p{font-size:13.5px; margin-bottom:20px;}

  .bill{background:var(--steel); border:1px solid #3a382d; border-radius:var(--radius); padding:18px; margin-top:22px;}
  .bill .row{display:flex; justify-content:space-between; font-size:13.5px; color:var(--off-dim); padding:6px 0; font-family:'Space Mono',monospace;}
  .bill .row.total{color:var(--off); font-weight:700; font-size:16px; border-top:1px dashed #3a382d; margin-top:8px; padding-top:14px;}
  .bill .row.total span:last-child{color:var(--turmeric);}

  /* ---------- Checkout form ---------- */
  h2.section-h{font-size:20px; margin-bottom:4px;}
  p.section-sub{font-size:13px; color:var(--off-dim); margin-bottom:22px;}
  .field{margin-bottom:16px;}
  .field label{display:block; font-size:11.5px; text-transform:uppercase; letter-spacing:0.08em; color:var(--off-dim); margin-bottom:7px; font-family:'Space Mono',monospace;}
  .field input, .field textarea{
    width:100%; background:var(--steel); border:1.5px solid #3a382d; color:var(--off);
    padding:13px 14px; border-radius:10px; font-size:14.5px; font-family:inherit;
    outline:none; transition:border-color .15s ease;
  }
  .field input:focus, .field textarea:focus{border-color:var(--turmeric);}
  .field textarea{resize:vertical; min-height:70px;}
  .field-row{display:flex; gap:12px;}
  .field-row .field{flex:1;}
  .err{color:var(--chili); font-size:11.5px; margin-top:6px; display:none; font-family:'Space Mono',monospace;}

  .locbtn{
    width:100%; display:flex; align-items:center; justify-content:center; gap:9px;
    background:var(--steel); border:1.5px dashed var(--turmeric-dim); color:var(--turmeric);
    padding:13px; border-radius:10px; font-size:13.5px; font-weight:700; cursor:pointer;
    font-family:inherit; margin-bottom:16px; transition:all .15s ease;
  }
  .locbtn:active{transform:scale(0.98);}
  .locbtn.loading{color:var(--off-dim); border-color:#4c4a3e; cursor:wait;}
  .locbtn.done{color:#7ec37e; border-color:#3f5c3f; border-style:solid;}
  .locbtn .spin{display:inline-block; animation:spin 0.8s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  /* ---------- Payment view ---------- */
  .pay-card{background:var(--steel); border:1px solid #3a382d; border-radius:var(--radius); padding:20px; margin-bottom:16px;}
  .pay-opt{
    display:flex; align-items:center; gap:14px; padding:16px; border:1.5px solid #3a382d; border-radius:12px;
    margin-bottom:12px; cursor:pointer; transition:border-color .15s ease;
  }
  .pay-opt.selected{border-color:var(--turmeric); background:rgba(232,163,61,0.06);}
  .pay-opt .logo{
    width:42px; height:42px; border-radius:10px; display:flex; align-items:center; justify-content:center;
    font-family:'Archivo Black',sans-serif; font-size:11px; flex-shrink:0;
  }
  .pay-opt .logo.phonepe{background:#5f259f; color:#fff;}
  .pay-opt .logo.razorpay{background:#0c2451; color:#3395ff;}
  .pay-opt .txt{flex:1;}
  .pay-opt .txt .t1{font-size:14.5px; font-weight:600;}
  .pay-opt .txt .t2{font-size:11.5px; color:var(--off-dim); margin-top:2px;}
  .pay-opt .radio{width:18px; height:18px; border-radius:50%; border:2px solid #4c4a3e; flex-shrink:0;}
  .pay-opt.selected .radio{border-color:var(--turmeric); background:radial-gradient(var(--turmeric) 0 40%, transparent 44%);}
  .pay-opt.disabled{cursor:not-allowed; opacity:0.45; filter:grayscale(0.4);}
  .soon-tag{
    display:inline-block; font-family:'Space Mono',monospace; font-size:9px; font-weight:700;
    color:var(--off-dim); background:#3a382d; padding:2px 7px; border-radius:8px;
    letter-spacing:0.05em; text-transform:uppercase; margin-left:6px; vertical-align:middle;
  }

  .loading-wrap{display:none; flex-direction:column; align-items:center; padding:50px 20px; text-align:center;}
  .loading-wrap.show{display:flex;}
  .stack{display:flex; flex-direction:column-reverse; gap:4px; margin-bottom:22px; height:70px; justify-content:flex-end;}
  .stack .tin-b{width:56px; height:14px; border-radius:6px; background:var(--turmeric); opacity:0; animation:pop .5s ease forwards;}
  .stack .tin-b:nth-child(1){animation-delay:.05s;}
  .stack .tin-b:nth-child(2){animation-delay:.25s;}
  .stack .tin-b:nth-child(3){animation-delay:.45s;}
  @keyframes pop{from{opacity:0; transform:translateY(8px) scaleX(0.8);} to{opacity:1; transform:none;}}
  .loading-wrap .lt{font-size:14.5px; font-weight:600; margin-bottom:6px;}
  .loading-wrap .ls{font-size:12.5px; color:var(--off-dim); font-family:'Space Mono',monospace;}

  .note{
    background:var(--steel); border:1px dashed #4c4a3e; border-radius:10px; padding:12px 14px;
    font-size:11.5px; color:var(--off-dim); line-height:1.5; margin-top:18px; font-family:'Space Mono',monospace;
  }
  .note b{color:var(--off);}

  /* ---------- Confirmation / ticket ---------- */
  .ticket{
    background:var(--paper); color:var(--ink); border-radius:10px; padding:24px 22px;
    position:relative; margin-top:8px;
    -webkit-mask-image: radial-gradient(circle 5px at 0 50%, transparent 5px, black 5.5px), radial-gradient(circle 5px at 100% 50%, transparent 5px, black 5.5px);
    -webkit-mask-composite: destination-out;
    mask-composite: intersect;
  }
  .ticket::before{
    content:''; position:absolute; top:0; bottom:0; left:0; width:0;
  }
  .ticket .perf{border-top:2px dashed #b7ae94; margin:16px 0;}
  .ticket .th{text-align:center; margin-bottom:6px;}
  .ticket .th .ok{
    width:44px; height:44px; border-radius:50%; background:#4c9a4c; color:#fff;
    display:flex; align-items:center; justify-content:center; font-size:22px; margin:0 auto 12px;
  }
  .ticket .th .t1{font-family:'Archivo Black',sans-serif; font-size:18px;}
  .ticket .th .t2{font-family:'Space Mono',monospace; font-size:11.5px; color:#6b6552; margin-top:4px;}
  .ticket .kv{display:flex; justify-content:space-between; font-size:12.5px; padding:4px 0; font-family:'Space Mono',monospace; color:#4a4636;}
  .ticket .kv b{color:var(--ink);}
  .ticket .items-mini .row{display:flex; justify-content:space-between; font-size:12.5px; padding:5px 0; font-family:'Space Mono',monospace;}
  .ticket .items-mini .row span:first-child{color:#4a4636;}
  .ticket .totrow{display:flex; justify-content:space-between; font-family:'Archivo Black',sans-serif; font-size:16px; margin-top:10px;}
  .eta-strip{
    display:flex; align-items:center; gap:10px; background:var(--steel); border:1px solid #3a382d;
    border-radius:12px; padding:14px 16px; margin:20px 0;
  }
  .eta-strip .icon{font-size:22px;}
  .eta-strip .t1{font-size:13.5px; font-weight:700;}
  .eta-strip .t2{font-size:11.5px; color:var(--off-dim); font-family:'Space Mono',monospace;}

  .order-track{background:var(--steel); border:1px solid #3a382d; border-radius:var(--radius); padding:20px 20px 16px; margin-bottom:16px;}
  .ot-title{font-size:12px; text-transform:uppercase; letter-spacing:0.12em; color:var(--off-dim); font-family:'Space Mono',monospace; margin-bottom:16px;}
  .ot-step{display:flex; gap:14px; position:relative; padding-bottom:22px;}
  .ot-step:last-child{padding-bottom:0;}
  .ot-line{position:absolute; left:11px; top:24px; bottom:-4px; width:2px; background:#3a382d;}
  .ot-step.done .ot-line{background:var(--turmeric-dim);}
  .ot-dot{
    width:24px; height:24px; border-radius:50%; background:var(--ink); border:2px solid #4c4a3e;
    color:transparent; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700;
    flex-shrink:0; z-index:1; transition:all .3s ease;
  }
  .ot-step.done .ot-dot{background:var(--turmeric); border-color:var(--turmeric); color:var(--ink);}
  .ot-step.active .ot-dot{border-color:var(--turmeric); box-shadow:0 0 0 4px rgba(232,163,61,0.18);}
  .ot-body .ot-nm{font-size:13.5px; font-weight:600; color:var(--off-dim);}
  .ot-step.done .ot-body .ot-nm, .ot-step.active .ot-body .ot-nm{color:var(--off);}
  .ot-body .ot-time{font-size:11px; color:#6b6858; font-family:'Space Mono',monospace; margin-top:3px;}
</style>
</head>
<body>
<div id="app">

  <header class="top">
    <svg class="tin-mark" viewBox="0 0 40 40" fill="none">
      <path d="M22 2 L8 22 H18 L15 38 L33 15 H22 L26 2 Z" fill="#ea1d25" stroke="#ffc72c" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
    <div class="brand">
      <span class="name display">ZINGO</span>
      <span class="tag">Taste can't wait · Barasat</span>
    </div>
  </header>

  <nav class="tracker" id="tracker">
    <div class="step" data-step="menu"><div class="line"></div><div class="tin"></div><div class="lbl">Menu</div></div>
    <div class="step" data-step="cart"><div class="line"></div><div class="tin"></div><div class="lbl">Cart</div></div>
    <div class="step" data-step="checkout"><div class="line"></div><div class="tin"></div><div class="lbl">Details</div></div>
    <div class="step" data-step="payment"><div class="line"></div><div class="tin"></div><div class="lbl">Pay</div></div>
    <div class="step" data-step="confirm"><div class="line"></div><div class="tin"></div><div class="lbl">Confirmed</div></div>
  </nav>

  <a href="#" id="wa-float" class="wa-float" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 32 32" width="26" height="26" fill="#fff"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.6 1.9 6.5L4 29l7.7-1.8C13.4 28 14.7 28.3 16 28.3c6.6 0 12-5.4 12-12S22.6 3 16 3zm0 22c-1.2 0-2.4-.3-3.5-.8l-.3-.1-4.6 1.1 1.1-4.4-.2-.3C7.5 19 7 17 7 15c0-5 4-9 9-9s9 4 9 9-4 9-9 9zm4.9-6.7c-.3-.1-1.6-.8-1.8-.9-.2-.1-.4-.1-.6.1s-.7.9-.9 1.1-.3.2-.6.1c-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.6-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.1.2-.3.2-.4.1-.1 0-.3 0-.4 0-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.6 1.1 2.8c.1.1 1.9 2.9 4.5 4 .6.3 1.1.4 1.5.6.6.2 1.2.2 1.6.1.5-.1 1.6-.6 1.8-1.3.2-.6.2-1.1.2-1.3-.1-.1-.3-.2-.5-.3z"/></svg>
  </a>

  <main>

    <!-- ============ VIEW 1: MENU (landing page) ============ -->
    <section class="view" id="view-menu">
      <div class="hero">
        <div class="eyebrow">Scan · Order · Zing</div>
        <h1 class="display">Loaded, cheesy,<br>fired up fast.</h1>
        <p>Pocket pizzas, crunch burgers &amp; boba — packed hot and sent straight to your door. Taste can't wait.</p>
      </div>

      <div class="best-strip" id="best-strip"></div>

