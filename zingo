/* ---------------- current location ---------------- */
function useCurrentLocation(){
  const btn = document.getElementById('loc-btn');
  const icon = document.getElementById('loc-icon');
  const label = document.getElementById('loc-label');
  const errEl = document.getElementById('loc-err');
  errEl.style.display = 'none';

  if(!navigator.geolocation){
    errEl.textContent = "Your browser doesn't support location access. Please type your address below.";
    errEl.style.display = 'block';
    return;
  }

  btn.classList.add('loading');
  icon.innerHTML = '<span class="spin">⟳</span>';
  label.textContent = 'Locating you…';

  navigator.geolocation.getCurrentPosition(
    async (pos) => {
      const { latitude, longitude } = pos.coords;
      try {
        label.textContent = 'Fetching address…';
        /* Free reverse-geocoding lookup (OpenStreetMap Nominatim, no API key).
           For production, swap this for Google Maps Geocoding API or
           MapmyIndia — both give more reliable results in India and
           support proper usage limits/keys. */
        const res = await fetch(
          `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${latitude}&lon=${longitude}`,
          { headers: { 'Accept': 'application/json' } }
        );
        const data = await res.json();
        const a = data.address || {};

        const line = [a.house_number, a.road, a.suburb].filter(Boolean).join(', ');
        const area = a.suburb || a.neighbourhood || a.city_district || a.city || a.town || '';
        const pin = a.postcode || '';

        if(line) document.getElementById('cf-address').value = line;
        if(area) document.getElementById('cf-area').value = area;
        if(pin) document.getElementById('cf-pin').value = pin;

        btn.classList.remove('loading');
        btn.classList.add('done');
        icon.textContent = '✓';
        label.textContent = 'Location added — check it below';
      } catch (e) {
        btn.classList.remove('loading');
        icon.textContent = '📍';
        label.textContent = 'Use current location';
        errEl.textContent = "Found your location but couldn't fetch the address. Please fill it in manually.";
        errEl.style.display = 'block';
      }
    },
    (error) => {
      btn.classList.remove('loading');
      icon.textContent = '📍';
      label.textContent = 'Use current location';
      errEl.textContent = error.code === error.PERMISSION_DENIED
        ? 'Location access was denied. You can type your address below instead.'
        : "Couldn't get your location. You can type your address below instead.";
      errEl.style.display = 'block';
    },
    { enableHighAccuracy:true, timeout:10000 }
  );
}

